[Unit]
Description=Nightly server backup to the gaming-pc (waits until services are idle)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hl-backup.py
# If systemd kills the job mid-run, containers must not be left stopped.
ExecStopPost=/usr/local/sbin/hl-containers-start
LoadCredentialEncrypted=smbcred:/etc/credstore.encrypted/<SMB_CRED_NAME>
LoadCredentialEncrypted=resticpw:/etc/credstore.encrypted/<RESTIC_CRED_NAME>
TimeoutStartSec=9h
Nice=10
IOSchedulingClass=idle
