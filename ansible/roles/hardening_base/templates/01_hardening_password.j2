#!/bin/sh
# Managed by Ansible (roles/hardening_base).  Do not edit by hand.
# GRUB superuser for EDITING entries, the GRUB command line and recovery mode only.  Normal kernels boot
# without a password because 09_linux_unrestricted marks them --unrestricted.
# Password: a secret in the server's TPM-bound store, named by hardening_base_grub_secret.
cat <<'GRUBEOF'
set superusers="{{ hardening_base_grub_user }}"
password_pbkdf2 {{ hardening_base_grub_user }} {{ hardening_base_grub_hash }}
GRUBEOF
