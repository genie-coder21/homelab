#!/usr/bin/python3.14
"""Render the app's Kubernetes Secrets from the TPM credstore (the k3s twin of hl-compose).

  sudo hl-k3s-secrets apply [--namespace <NAMESPACE>]     # (re)create Secret app-secrets + app-registry
  sudo hl-k3s-secrets show                           # which credstore names feed which keys (no values)

Same contract as hl-compose: the credstore (`hl-secret`, TPM-bound, this machine only) is the ONE source of
truth; values are read at apply time, piped straight into `kubectl apply -f -` (never written to disk), and live
only in the k3s datastore (encrypted at rest: `secrets-encryption: true`) and in pod environments. The worker
nodes, the gaming-pc included, hold no credstore and no copy of these files. Rotate: `hl-secret set`, then
re-run `apply`, then redeploy the workers (env is read at container start).
"""
from __future__ import annotations
import argparse, base64, json, subprocess, sys

# key in the pods' environment -> credstore name. Mirrors /opt/app/.env.template (workers' share of it).
WORKER_KEYS = {  # CONFIG: key in the pods' environment -> credstore name
    "APP_DB_PASSWORD": "app-dbpass",
    "APP_NOTIFY_TOKEN": "notify-token",
}
OPTIONAL = {"APP_OPTIONAL_KEY": "app-optional-key"}   # only if the credstore has it
REGISTRY = {"host": "<REGISTRY_HOST>:<REGISTRY_PORT>", "user": "<REGISTRY_USER>", "secret": "registry-password"}
KUBECONFIG = "/etc/rancher/k3s/k3s.yaml"


def get(name: str, optional: bool = False) -> str | None:
    r = subprocess.run(["/usr/local/sbin/hl-secret", "get", name], capture_output=True, text=True)
    if r.returncode:
        if optional:
            return None
        sys.exit(f"missing secret '{name}' — add it with: hl-secret new {name}")
    return r.stdout.strip()


def b64(s: str) -> str:
    return base64.b64encode(s.encode()).decode()


def manifests(ns: str) -> list[dict]:
    data = {k: b64(get(v)) for k, v in WORKER_KEYS.items()}
    for k, v in OPTIONAL.items():
        val = get(v, optional=True)
        if val is not None:
            data[k] = b64(val)
    out = [{"apiVersion": "v1", "kind": "Secret", "type": "Opaque",
            "metadata": {"name": "app-secrets", "namespace": ns,
                         "labels": {"app.kubernetes.io/part-of": "app", "homelab/source": "hl-secret"}},
            "data": data}]
    pw = get(REGISTRY["secret"], optional=True)
    if pw is not None:
        auth = {"auths": {REGISTRY["host"]: {"username": REGISTRY["user"], "password": pw,
                                               "auth": b64(f"{REGISTRY['user']}:{pw}")}}}
        out.append({"apiVersion": "v1", "kind": "Secret", "type": "kubernetes.io/dockerconfigjson",
                    "metadata": {"name": "app-registry", "namespace": ns,
                                 "labels": {"app.kubernetes.io/part-of": "app", "homelab/source": "hl-secret"}},
                    "data": {".dockerconfigjson": b64(json.dumps(auth))}})
    return out


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["apply", "show"])
    ap.add_argument("--namespace", default="app")
    a = ap.parse_args()
    if a.cmd == "show":
        for k, v in {**WORKER_KEYS, **OPTIONAL}.items():
            print(f"{k:28} <- {v}")
        print(f"{'app-registry':28} <- {REGISTRY['secret']} (user {REGISTRY['user']} @ {REGISTRY['host']})")
        return 0
    docs = manifests(a.namespace)
    body = json.dumps({"apiVersion": "v1", "kind": "List", "items": docs})
    r = subprocess.run(["/usr/local/bin/kubectl", "--kubeconfig", KUBECONFIG, "apply", "-f", "-"],
                       input=body, text=True)
    return r.returncode


if __name__ == "__main__":
    raise SystemExit(main())
