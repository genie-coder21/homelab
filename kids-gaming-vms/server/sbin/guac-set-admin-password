#!/bin/bash
# Replace Guacamole's shipped default admin password with one held as a systemd-creds
# encrypted credential (TPM-bound). Idempotent: if the stored password already works,
# it does nothing.
#
# Uses the REST API rather than writing the DB directly: Guacamole salts and hashes
# passwords itself, and doing that by hand would break the moment the scheme changes.
#
# The secret never touches disk - systemd decrypts it into a private tmpfs that only
# this transient unit can read. Needs root.
set -euo pipefail
URL=${GUAC_URL:-http://localhost:<GUAC_PORT>}
ADMIN_USER=${GUAC_ADMIN_USER:-guacadmin}                     # the schema's built-in admin
CRED_NAME=${GUAC_ADMIN_CRED:-<GUAC_ADMIN_PASS_CRED>}         # credential name in the credstore
CRED_PATH=${GUAC_ADMIN_CRED_PATH:-/etc/credstore.encrypted/$CRED_NAME}

exec systemd-run --pipe --quiet --collect --unit="guac-setpw-$$" \
  --property=LoadCredentialEncrypted=guac-adminpass:"$CRED_PATH" \
  --setenv=GUAC_URL="$URL" --setenv=ADMIN_USER="$ADMIN_USER" \
  /bin/bash -c '
    set -euo pipefail
    NEW=$(cat "$CREDENTIALS_DIRECTORY/guac-adminpass")
    # Try the shipped default first, then the stored one (already applied).
    for OLD in "guacadmin" "$NEW"; do
      TOKEN=$(curl -s -m 10 --data-urlencode "username=$ADMIN_USER" \
                   --data-urlencode "password=$OLD" \
                   "$GUAC_URL/api/tokens" | sed -n "s/.*\"authToken\":\"\([^\"]*\)\".*/\1/p")
      [ -n "$TOKEN" ] && break
    done
    if [ -z "${TOKEN:-}" ]; then
      echo "could not log in as $ADMIN_USER with either the default or the stored password" >&2
      exit 1
    fi
    if [ "$OLD" = "$NEW" ]; then
      echo "already set to the stored secret - nothing to do"
      exit 0
    fi
    CODE=$(curl -s -o /dev/null -w "%{http_code}" -m 10 -X PUT \
      -H "Content-Type: application/json" \
      "$GUAC_URL/api/session/data/postgresql/users/$ADMIN_USER/password?token=$TOKEN" \
      --data "$(printf "{\"oldPassword\":\"%s\",\"newPassword\":\"%s\"}" "$OLD" "$NEW")")
    if [ "$CODE" = "204" ]; then echo "$ADMIN_USER password set from the stored credential"
    else echo "password change failed, HTTP $CODE" >&2; exit 1; fi
  '
