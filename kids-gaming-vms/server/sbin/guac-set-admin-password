#!/bin/bash
# Replace Guacamole's shipped default admin password with one held as a systemd-creds
# encrypted credential (TPM-bound). Idempotent: if the stored password already works,
# it does nothing.
#
# Uses the REST API rather than writing the DB directly: Guacamole salts and hashes
# passwords itself, and doing that by hand would break the moment the scheme changes.
#
# The secret never touches disk - systemd decrypts it into a private tmpfs that only
# this transient unit can read. urllib sends it in-process. Needs root.
set -euo pipefail
URL=${GUAC_URL:-http://localhost:<GUAC_PORT>}
ADMIN_USER=${GUAC_ADMIN_USER:-<GUAC_ADMIN_USER>}
SHIPPED_DEFAULT=${GUAC_SHIPPED_DEFAULT:-<SHIPPED_DEFAULT_PASSWORD>}
CRED_NAME=${GUAC_ADMIN_CRED:-<GUAC_ADMIN_PASS_CRED>}         # credential name in the credstore
CRED_PATH=${GUAC_ADMIN_CRED_PATH:-/etc/credstore.encrypted/$CRED_NAME}

exec systemd-run --pipe --quiet --collect --unit="guac-setpw-$$" \
  --property=LoadCredentialEncrypted=guac-adminpass:"$CRED_PATH" \
  --setenv=GUAC_URL="$URL" --setenv=ADMIN_USER="$ADMIN_USER" --setenv=SHIPPED_DEFAULT="$SHIPPED_DEFAULT" \
  /usr/bin/python3 -I -c '
import json, os, sys, urllib.error, urllib.parse, urllib.request
url, user = os.environ["GUAC_URL"], os.environ["ADMIN_USER"]
with open(os.path.join(os.environ["CREDENTIALS_DIRECTORY"], "guac-adminpass")) as f:
    new = f.read().rstrip("\n")
token = None
for old in (os.environ["SHIPPED_DEFAULT"], new):
    body = urllib.parse.urlencode({"username": user, "password": old}).encode()
    try:
        with urllib.request.urlopen(url + "/api/tokens", data=body, timeout=10) as r:
            token = json.load(r)["authToken"]
        break
    except urllib.error.HTTPError:
        pass
if token is None:
    sys.exit("could not log in as " + user + " with either the default or the stored password")
if old == new:
    print("already set to the stored secret - nothing to do")
    sys.exit(0)
req = urllib.request.Request(
    url + "/api/session/data/postgresql/users/" + user + "/password", method="PUT",
    data=json.dumps({"oldPassword": old, "newPassword": new}).encode(),
    headers={"Content-Type": "application/json", "Guacamole-Token": token})
try:
    urllib.request.urlopen(req, timeout=10).close()
except urllib.error.HTTPError as e:
    sys.exit("password change failed, HTTP " + str(e.code))
print(user + " password set from the stored credential")
'
