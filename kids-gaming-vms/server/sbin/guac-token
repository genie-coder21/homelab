#!/bin/bash
# Build an encrypted guacamole-auth-json blob on stdout from a JSON descriptor on stdin.
# Standalone/debug helper; the launcher does the same thing in-process.
#
# Format (mirrors the extension's own encrypt-json.sh):
#   HMAC-SHA256(json, hexkey) || json   ->  AES-128-CBC, null IV, no salt  ->  base64
#
# Crypto runs in-process using python3-cryptography. The key is a systemd-creds encrypted
# credential (TPM-bound) and is only ever decrypted into the transient unit's private
# credentials directory. Needs root.
set -euo pipefail
CRED_NAME=${GUAC_JSON_CRED:-<GUAC_JSON_KEY_CRED>}            # credential name in the credstore
CRED_PATH=${GUAC_JSON_CRED_PATH:-/etc/credstore.encrypted/$CRED_NAME}

exec systemd-run --pipe --quiet --collect --unit="guac-token-$$" \
  --property=LoadCredentialEncrypted=guac-jsonkey:"$CRED_PATH" \
  /usr/bin/python3 -I -c '
import base64, hashlib, hmac, os, sys
from cryptography.hazmat.primitives import padding
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
with open(os.path.join(os.environ["CREDENTIALS_DIRECTORY"], "guac-jsonkey")) as f:
    key = bytes.fromhex(f.read().strip())
raw = sys.stdin.buffer.read()
pad = padding.PKCS7(128).padder()
plain = pad.update(hmac.new(key, raw, hashlib.sha256).digest() + raw) + pad.finalize()
enc = Cipher(algorithms.AES(key), modes.CBC(bytes(16))).encryptor()
sys.stdout.write(base64.b64encode(enc.update(plain) + enc.finalize()).decode())
'
