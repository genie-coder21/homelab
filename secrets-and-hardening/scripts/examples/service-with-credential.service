# Giving a TPM-held secret to a systemd service. The decrypted value appears at
# $CREDENTIALS_DIRECTORY/<SECRET_NAME>: a private, root-only tmpfs that disappears
# when the unit stops. No wrapper script needed - and wrappers that call systemd-run
# to decrypt fail for non-root services ("Interactive authentication required").
[Unit]
Description=Example job that needs a secret

[Service]
Type=oneshot
LoadCredentialEncrypted=<SECRET_NAME>:/etc/credstore.encrypted/<SECRET_NAME>
ExecStart=/usr/local/sbin/example-job
