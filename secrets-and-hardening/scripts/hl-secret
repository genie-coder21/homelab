#!/usr/bin/env python3
"""Manage TPM-encrypted secrets for this machine (root only).

  hl-secret set  <name>      read the value from stdin and encrypt it
  hl-secret new  <name>      generate a strong random value, encrypt it, print it once
  hl-secret get  <name>      print the value
  hl-secret list             what's stored (names only)
  hl-secret rm   <name>

Secrets live in STORE, encrypted with systemd-creds to this machine's TPM: the files
are useless if copied to another computer. systemd units read them with
LoadCredentialEncrypted=; containers get them through hl-compose.
"""
from __future__ import annotations
import os, secrets, string, subprocess, sys
from pathlib import Path

STORE = Path("/etc/credstore.encrypted")   # systemd's standard search path for encrypted credentials
GENERATED_LENGTH = 28


def store(name: str, value: bytes) -> None:
    STORE.mkdir(parents=True, exist_ok=True, mode=0o700)
    p = subprocess.run(["systemd-creds", "encrypt", "--name", name, "-", str(STORE / name)],
                       input=value, capture_output=True)
    if p.returncode:
        sys.exit(f"encrypt failed: {p.stderr.decode().strip()}")
    (STORE / name).chmod(0o600)


def read(name: str) -> str:
    p = subprocess.run(["systemd-creds", "decrypt", "--name", name, str(STORE / name), "-"],
                       capture_output=True)
    if p.returncode:
        sys.exit(f"decrypt failed: {p.stderr.decode().strip()}")
    return p.stdout.decode()


def main() -> int:
    if os.geteuid() != 0:
        sys.exit("hl-secret must run as root")
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd = sys.argv[1]
    if cmd == "list":
        for f in sorted(STORE.glob("*")):
            print(f"  {f.name}")
        return 0
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    name = sys.argv[2]
    if cmd == "set":
        value = sys.stdin.buffer.read().strip()   # stdin, never argv: argv shows up in ps and shell history
        if not value:
            sys.exit("no value on stdin")
        store(name, value)
        print(f"stored '{name}' (TPM-encrypted)")
    elif cmd == "new":
        alphabet = string.ascii_letters + string.digits + "!@#%^*-_=+"
        value = "".join(secrets.choice(alphabet) for _ in range(GENERATED_LENGTH))
        store(name, value.encode())
        print(f"stored '{name}'. The value (shown once - save it if a human needs it):\n\n  {value}\n")
    elif cmd == "get":
        print(read(name), end="")
    elif cmd == "rm":
        (STORE / name).unlink(missing_ok=True)
        print(f"removed '{name}'")
    else:
        sys.exit(__doc__)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
